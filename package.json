{
  "name": "react-refetch",
  "version": "3.1.0",
  "description": "A simple declarative request wrapper for React components",
  "main": "lib/index.js",
  "typings": "src/index.d.ts",
  "scripts": {
    "clean": "rimraf lib",
    "build": "babel src --out-dir lib",
    "lint": "eslint src test",
    "test": "mocha --require @babel/register --require test/setup.js test/**/*.spec.js",
    "test:watch": "npm test -- --watch",
    "prepublish": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/react-refetch.git"
  },
  "keywords": [
    "react",
    "refetch",
    "fetch",
    "rest",
    "api",
    "data",
    "flux",
    "redux"
  ],
  "author": "Daniel Bukowski <dbukowski@salesforce.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/heroku/react-refetch/issues"
  },
  "homepage": "https://github.com/heroku/react-refetch#readme",
  "dependencies": {
    "hoist-non-react-statics": "^3.3.2",
    "invariant": "^2.2.4",
    "warning": "^4.0.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.10",
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/register": "^7.12.10",
    "eslint": "^7.16.0",
    "eslint-plugin-react": "^7.22.0",
    "expect": "^1.20.2",
    "jsdom": "^16.4.0",
    "mocha": "^8.2.1",
    "rimraf": "^3.0.2",
    "whatwg-fetch": "^3.6.2"
  },
  "peerDependencies": {
    "react": "^0.14.0 || ^15.0.0-0 || ^16.0.0-0 || ^17.0.0-0"
  }
}
